<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Loan Request Message Channel</masterLabel>
    <isExposed>true</isExposed>
    <description>Publishes LoanRequest save events so other LWC components can react.</description>
    <lightningMessageFields>
        <fieldName>loanRequestId</fieldName>
        <description>Saved LoanRequest Id</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>customerName</fieldName>
        <description>Customer full name</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>loanAmount</fieldName>
        <description>Loan amount</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>loanStatus</fieldName>
        <description>Loan status</description>
    </lightningMessageFields>
</LightningMessageChannel>
